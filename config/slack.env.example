# Copy to config/slack.env and fill in. That file is gitignored.
# Place it yourself on the Air via terminal; never paste a token into chat.

# Bot User OAuth Token for "Sales Pulse Bot" (App ID A0BS83JVCLU) in the LGV
# workspace. This is the Pulse's OWN app, separate from the daily brief's.
# Scopes required: chat:write, channels:history. Nothing else.
SLACK_BOT_TOKEN=xoxb-...

# The #sales-pulse channel in the LGV workspace.
# Slack: right-click the channel > View channel details > ID at the bottom.
SLACK_CHANNEL_ID=C...

# Mark's Slack user ID. The gate accepts a reply from this user and no other.
# Slack: your avatar > Profile > three dots > Copy member ID.
SLACK_USER_ID=U...
