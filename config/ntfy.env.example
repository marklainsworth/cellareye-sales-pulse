# Copy to config/ntfy.env and fill in. That file is gitignored.
#
# The topic IS the secret: anyone who knows it can publish to it and anyone
# subscribed receives it. Use the long random one, do not shorten it.
# Subscribe on your phone: install ntfy from the App Store, Add subscription,
# paste the same topic.
NTFY_TOPIC=cellareye-pulse-REPLACE_WITH_RANDOM

# Optional. Only needed if you self-host or use a reserved topic on ntfy.sh.
#NTFY_SERVER=https://ntfy.sh
#NTFY_TOKEN=
