<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cellareye.salespulse.poll</string>

  <!-- Reads Mark's replies. Without this the Friday prompt opens a gate that
       nobody ever answers: pulse-prompt only asks the question.

       One tick per minute, and a tick with no gate open exits immediately
       without calling Slack, so this costs nothing for the 167 hours a week
       the gate is closed. Ticks missed while the Air sleeps are harmless: the
       state is on disk and the reply waits in Slack history. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/marklucianoainsworth/lgv/cellareye-sales-pulse/bin/pulse-gate</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/marklucianoainsworth/lgv/cellareye-sales-pulse</string>

  <!-- launchd gives a job almost no PATH. The runner shells out to `claude`
       for summarisation and to `git`, so this has to be explicit. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/marklucianoainsworth/.local/bin:/Users/marklucianoainsworth/lgv/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>/Users/marklucianoainsworth</string>
    <key>PYTHONWARNINGS</key><string>ignore</string>
    <key>LANG</key><string>en_US.UTF-8</string>
  </dict>

  <key>StartInterval</key><integer>60</integer>

  <!-- Safe to fire on load: with no gate open it does nothing. -->
  <key>RunAtLoad</key><false/>

  <key>StandardOutPath</key>
  <string>/Users/marklucianoainsworth/lgv/logs/pulse.poll.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/marklucianoainsworth/lgv/logs/pulse.poll.err.log</string>

  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
