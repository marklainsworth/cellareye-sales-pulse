#!/bin/bash
# Fired by launchd at Friday 15:00. Opens the Slack gate and exits.
#
# It posts to #sales-pulse rather than raising a macOS notification: the Air
# lives in the casita and Mark is frequently on the road, so a local
# notification would be invisible exactly when it matters. It does NOT run the
# Pulse. Mark answers in the thread from wherever he is, and bin/pulse-gate
# picks the reply up on its next tick.
set -euo pipefail
cd "$(dirname "$0")/.."
exec /usr/bin/env python3 -m pipeline.gate_runner --open "$@"
